{
    "compilerOptions": {
        "outDir": "./dist",
        "target": "ES2017",
        "module": "commonjs",
        "esModuleInterop": true,
        "sourceMap": true,
        "noImplicitAny": false,
        "declaration": true
    },
    "include": [
        "./src/**/*"
    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts",
        "dist/*"
    ]
}